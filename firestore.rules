rules_version = '2';

// BLISS JULI — Firestore security rules
// ---------------------------------------------------------------
// Apply these in the Firebase Console:
//   Firestore Database -> Rules tab -> paste -> Publish
//
// OWNER_UID is the "user id" of your admin account
// (Firebase Console -> Authentication -> Users -> User UID).
// Only that account can write content; everyone can read.
// ---------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'lLfQ3oHAqcgqK9E1LgPZ7THQjGJ2';
    }
  }
}
