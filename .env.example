# ════════════════════════════════════════════════════════════════
# Bliss Juli Portfolio — Environment Variables
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# NOTE: This is a static site — these values are exposed to the
# browser. Firebase client-side keys are designed to be public,
# but the .env pattern keeps them out of source control so you
# can rotate them without touching committed code.
# ════════════════════════════════════════════════════════════════

# Firebase configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=my-portfolio-website-62aa4.firebaseapp.com
FIREBASE_PROJECT_ID=my-portfolio-website-62aa4
FIREBASE_STORAGE_BUCKET=my-portfolio-website-62aa4.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin UID (from Firebase Console → Authentication → Users)
FIREBASE_ADMIN_UID=

# Contact form endpoint (Formspree, Netlify Forms, etc.)
CONTACT_FORM_URL=
