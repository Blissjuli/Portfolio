rules_version = '2';

// BLISS JULI — Firebase Storage rules
// ---------------------------------------------------------------
// Apply these in the Firebase Console:
//   Storage -> Rules tab -> paste -> Publish
//
// OWNER_UID is the "user id" of your admin account
// (Firebase Console -> Authentication -> Users -> User UID).
// Everyone can read uploaded files; only the admin can upload/delete.
// ---------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {
    match /blissjuli/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'lLfQ3oHAqcgqK9E1LgPZ7THQjGJ2';
    }
  }
}